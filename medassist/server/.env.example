# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq — console.groq.com → API Keys → Create
# Groq-only (recommended for demos): set only GROQ_API_KEY and optionally:
# EXCLUDED_AI_PROVIDERS=openai,cerebras,sambanova,openrouter,github
GROQ_API_KEY=

# Gemini Vision (optional, OCR only) — aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cerebras — cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=

# SambaNova — cloud.sambanova.ai → API
SAMBANOVA_API_KEY=

# OpenRouter — openrouter.ai → Keys
OPENROUTER_API_KEY=

# GitHub Models — github.com/settings/tokens (needs Models: Read permission)
GITHUB_TOKEN=

# Helicone observability — helicone.ai → API Keys
HELICONE_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Voice (optional) ──────────────────────────────────────────────────────────
# ElevenLabs — premium TTS. If unset, the app uses browser Speech Synthesis (free).
ELEVENLABS_API_KEY=

# ── Email (pick one provider) ─────────────────────────────────────────────────
# Gmail OAuth (production on Render) — GMAIL_REFRESH_TOKEN + GOOGLE_CLIENT_* above
# Brevo HTTP API
BREVO_API_KEY=
# Resend (dev: often limited to account owner email)
RESEND_API_KEY=
EMAIL_FROM=MedAssist AI <onboarding@resend.dev>
# SMTP — local dev fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# ── App URLs ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
